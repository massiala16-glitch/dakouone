rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Photos des signalements
    match /signalements/{fichier} {
      allow read: if true;                                  // photos visibles sur la carte
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024          // 2 Mo max
        && request.resource.contentType.matches('image/.*'); // images uniquement
    }
  }
}
